{
  "name": "projeto-ia",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "features": { "ghcr.io/devcontainers/features/github-cli:1": {} },
  "hostRequirements": { "cpus": 2 },
  "forwardPorts": [3000],
  "postCreateCommand": "npm install -g vercel && curl -fsSL https://claude.ai/install.sh | bash && (npm install || true)",
  "secrets": {
    "NEXT_PUBLIC_SUPABASE_URL": { "description": "URL do projeto Supabase" },
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": { "description": "Chave pública (publishable)" },
    "SUPABASE_SECRET_KEY": { "description": "Chave secreta: só servidor" }
  }
}
